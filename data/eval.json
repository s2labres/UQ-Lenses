  "date": "2026-11-23",
  "data": "Counts are never typed in. Placeholders in braces are filled at render time from papers.json: {papers} unique papers; {cor}, {cor_rnk_only}, {all_rnk_only} from sankey.headline (cor_rnk_only is also recomputed from papers[] and asserted); {tgt:COR} unique papers with a target; {met:RNK} unique papers with a metric family; {tl:GRD:str} unique papers with a target at a lens.",
  "math": "Strings may contain LaTeX between \\( \\), typeset with MathJax 3 (tex-svg). All *_html fields are trusted, author-written HTML."
 },
 "lede_html": "A UQ evaluation protocol evaluates the uncertainty score against a <b>target</b>. A <b>criterion</b> decides whether the target is met. A <b>metric</b> measures how well the score tracks the target.",
 "protocol": {
  "title": "Target, criterion, metric",
  "steps": {
   "target": {
    "name": "Target",
    "def_html": "A property of the inference instance \\(\\langle x, f_\\theta, y\\rangle\\) that the uncertainty score is evaluated against."
   },
   "criterion": {
    "name": "Criterion",
    "def_html": "A function \\(C(\\cdot,\\cdot)\\) that decides whether an instance has the target property."
   },
   "metric": {
    "name": "Metric",
    "def_html": "Measures how well the uncertainty scores track the labels the criterion gives."
   }
  },
  "target_order": [
   "COR",
   "GRD",
   "UNS",
   "FTH"
  ],
  "targets": {
   "COR": {
    "of_html": "A property of the output \\(y\\) alone: does \\(y\\) match a ground-truth answer \\(y^*\\) under a criterion \\(C(y, y^*)\\)? The default target in the literature.",
    "question": "How well does the uncertainty estimate tell whether the response is correct?",
    "gt": true
   },
   "GRD": {
    "of_html": "A property of the output \\(y\\), the context in the input \\(x\\), and the model \\(f_\\theta\\): contextual support (is \\(y\\) supported by the context?) and causal reliance (does \\(f_\\theta\\) use the context or its own parametric knowledge?).",
    "question": "How well does the uncertainty estimate tell whether the response is grounded in the context?",
    "gt": true
   },
   "UNS": {
    "of_html": "A property of the input \\(x\\) alone: does \\(x\\) admit a valid answer? Covers answerability, ambiguity and novelty; the label comes from dataset annotation.",
    "question": "How well does the uncertainty estimate tell whether the input is underspecified?",
    "gt": true
   },
   "FTH": {
    "of_html": "A property of the output \\(y\\) and the model \\(f_\\theta\\): does \\(y\\) reflect the model's own knowledge or reasoning? It compares two uncertainty signals from the same model.",
    "question": "How well do the model's own uncertainty signals agree with one another?",
    "gt": false
   }
  },
  "gt_label": {
   "yes": "needs a ground-truth label",
   "no": "needs no ground truth"
  },
  "criterion_label": "Criterion",
  "criteria": [
   {
    "key": "dis",
    "name": "Distributional",
    "def": "Measures the lexical overlap between the output and the reference.",
    "examples": [
     "exact match",
     "BLEU",
     "ROUGE-1/2/L"
    ]
   },
   {
    "key": "sem",
    "name": "Semantical",
    "def": "Assesses a meaning-level property.",
    "examples": [
     "option match",
     "NLI entailment",
     "LLM-as-judge",
     "FActScore",
     "AlignScore",
     "human annotation"
    ]
   }
  ],
  "criterion_link_html": "The split is whether \\(C\\) reads the lexical form. This is the information discarded by the lens map <a href=\"#lenses-four\">\\(g_R\\)</a>.",
  "metric_order": [
   "RNK",
   "CAL",
   "SCR",
   "DEC",
   "REG",
   "COV",
   "FTH"
  ],
  "metrics": {
   "RNK": {
    "def": "Does the score place positive instances ahead of negative ones? Summarizes the separation over all decision thresholds.",
    "examples": [
     "AUROC",
     "AUPRC",
     "AUARC",
     "AURC",
     "PRR"
    ]
   },
   "CAL": {
    "def": "Agreement between the probability and the empirical frequency of positive instances.",
    "examples": [
     "ECE",
     "MCE",
     "ACE"
    ]
   },
   "SCR": {
    "def": "Proper scoring rules: calibration and the concentration of the predicted distribution.",
    "examples": [
     "Brier score",
     "CRPS"
    ]
   },
   "DEC": {
    "def": "The score thresholded for a downstream decision, such as abstention: a single operating point on a ranking curve.",
    "examples": [
     "accuracy",
     "F1 score"
    ]
   },
   "REG": {
    "def": "When the criterion returns a continuous score: the correlation between the uncertainty score and the criterion score.",
    "examples": [
     "PCC",
     "SCC"
    ]
   },
   "COV": {
    "def": "Specific to conformal prediction: does the prediction set contain an acceptable response with the chosen probability, and how large is it?",
    "examples": [
     "coverage probability",
     "average prediction set size"
    ]
   },
   "FTH": {
    "def": "For the faithfulness target: agreement between two uncertainty signals of the same model.",
    "examples": [
     "rank correlation",
     "cMFG",
     "CoT intervention"
    ]
   }
  },
  "examples_label": "e.g."
 },
 "flow": {
  "title": "How the {papers} surveyed papers evaluate",
  "sub": "Band width is the number of papers that evaluate a target with a metric family.",
  "heads": {
   "target": "Target",
   "metric": "Metric family"
  },
  "headline": [
   "{cor_rnk_only} of {cor} correctness papers",
